# Generate strong unique values before deployment. Never commit your real .env.
POSTGRES_DB=argumentum
POSTGRES_USER=argumentum
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_SECRET
REDIS_PASSWORD=REPLACE_WITH_REDIS_SECRET
ARGUMENTUM_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_BEARER_TOKEN
ARGUMENTUM_ADMIN_TOKEN=REPLACE_WITH_A_DIFFERENT_PLATFORM_ADMIN_TOKEN
ARGUMENTUM_SANDBOX_POLL_SECONDS=1
ARGUMENTUM_EXTRAS=server,all-documents

# Self-hosted Ollama is included in compose.yaml and is private to the Docker network.
# Pull the model you choose separately, then match the model name below.
ARGUMENTUM_LLM_BASE_URL=http://ollama:11434/v1
ARGUMENTUM_LLM_API_KEY=
ARGUMENTUM_LLM_MODEL=qwen2.5:14b
ARGUMENTUM_AGENT_HARNESS=native
ARGUMENTUM_PIPELINE_HARNESS=native
ARGUMENTUM_TIMEOUT_SECONDS=180
ARGUMENTUM_MAX_RETRIES=2
ARGUMENTUM_JOB_TIMEOUT=7200
ARGUMENTUM_JOB_RETRIES=2
ARGUMENTUM_RECONCILE_INTERVAL_SECONDS=60
ARGUMENTUM_STALE_WORKER_SECONDS=1800
ARGUMENTUM_RECONCILE_BATCH_SIZE=50

# Host binding defaults to localhost. Put a TLS reverse proxy in front before remote access.
ARGUMENTUM_BIND_HOST=127.0.0.1
ARGUMENTUM_PORT=8080
ARGUMENTUM_DOCS_ENABLED=true

# Optional OpenAlex polite-pool configuration
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
ARGUMENTUM_MAILTO=

# Optional structured PDF extraction with the GROBID Compose profile
ARGUMENTUM_GROBID_URL=
ARGUMENTUM_GROBID_TIMEOUT_SECONDS=180
GROBID_IMAGE=grobid/grobid:0.8.2

# Optional vLLM profile (requires a compatible NVIDIA GPU/runtime)
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct
VLLM_API_KEY=REPLACE_WITH_VLLM_SECRET
HUGGING_FACE_HUB_TOKEN=
